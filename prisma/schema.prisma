generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Training {
  id String @id  @default(uuid())
  muscleGroup MuscleGroups[]
  
  exercises Exercise[] 
  sets Set[]
  createdAt DateTime @default(now())
}

model Exercise {
  id String @id  @default(uuid())
  image String?
  name String
  sets Set[]
  muscleGroup MuscleGroups
  trainings Training[] 

  createdAt DateTime @default(now())
}

model Set {
  id String @id  @default(uuid())
  kg Int
  reps Int
  note String?
  isIncrease Boolean @default(false)
  rest String?

  exercise Exercise @relation(references: [id], fields: [exerciseId] )
  exerciseId String
  training Training? @relation(references: [id],fields: [trainingId])
  trainingId String
  isBest Boolean @default(false)

  createdAt DateTime @default(now())
}




enum MuscleGroups {
  BREAST 
  BACK
  LEGS
  TRICEPS
  BICEPS
}